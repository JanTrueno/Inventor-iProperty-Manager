<Project Sdk="Microsoft.NET.Sdk">

  <!-- Inventor 2025 hosts add-ins on .NET 8 (CoreCLR), not .NET Framework. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>IPropertyManager</AssemblyName>
    <RootNamespace>IPropertyManager</RootNamespace>
    <Version>1.0.0</Version>
    <Product>iProperty Manager for Inventor</Product>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>CA1416;CS8002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <!-- Autodesk Weave icons (Apache-2.0), pre-rendered; see THIRD-PARTY-NOTICES.txt -->
    <EmbeddedResource Include="src\Assets\Weave\*.png" LogicalName="IPropertyManager.Weave.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resolved from Inventor's own copy at run time; never ship a second one. -->
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>C:\Program Files\Autodesk\Inventor 2025\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
